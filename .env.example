# Gemini API Key (必須: AI分析および国内競合検索グラウンディングに使用)
GEMINI_API_KEY=your_gemini_api_key_here

# Product Hunt API Token (任意: 未設定の場合は公式RSSフィードから自動収集)
PRODUCTHUNT_TOKEN=your_ph_developer_token_here

# 分析モデル設定 (デフォルト: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 日次取得件数上限 (デフォルト: 10)
DAILY_FETCH_LIMIT=10

# ダッシュボード保護パスワード (設定するとHTMLがAES-GCM暗号化され、パスワード入力が必要になります)
DASHBOARD_PASSWORD=your_secret_password_here

# GitHub Pages 自動アップロード設定 (任意: 設定するとGitHub Pagesに自動デプロイ)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO=your_username/your_repo_name

# 通知設定 (任意: Discord / Slack Webhook URLを設定するとSランク検知時や完了時に自動通知)
WEBHOOK_URL=https://discord.com/api/webhooks/...

# Threads 自動投稿設定 (公式Threads API)
THREADS_ACCESS_TOKEN=TH_your_threads_access_token_here
THREADS_AUTO_PUBLISH=true
THREADS_MAX_DAILY_POSTS=1

